<?xml version="1.0" encoding="utf-8"?>
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="?android:colorControlHighlight">
    <item>
        <layer-list>
            <!-- RIGHT LAYER (ID for Tinting) -->
            <item
                android:id="@+id/layer_slash_right"
                android:gravity="end"
                android:width="72dp"
                android:drawable="@drawable/vec_slash_right" />

            <!-- LEFT LAYER GROUP -->
            <!-- Inset 60dp from right to create the 4dp visual gap -->
            <item android:right="60dp">
                <layer-list>
                    <!-- The Diagonal Tip (Pinned to Right) -->
                    <item
                        android:gravity="end"
                        android:width="16dp"
                        android:drawable="@drawable/vec_slash_left_tip" />

                    <!-- The Solid Body (Stretches) -->
                    <!-- Inset 16dp inside this group (total 76dp from parent right) -->
                    <item android:right="16dp">
                        <shape android:shape="rectangle">
                            <solid android:color="@color/settingslib_materialColorSurfaceBright" />
                            <corners
                                android:topLeftRadius="@dimen/settingslib_preference_corner_radius"
                                android:bottomLeftRadius="@dimen/settingslib_preference_corner_radius" />
                        </shape>
                    </item>
                </layer-list>
            </item>
        </layer-list>
    </item>
</ripple>
