<PreferenceScreen
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:settings="http://schemas.android.com/apk/res/com.android.settings"
    android:title="@string/cutout_progress_title">

    <PreferenceCategory android:title="@string/cutout_progress_cat_features">

        <com.alpha.settings.preferences.SystemSettingSwitchPreference
            android:key="cutout_progress_download_enabled"
            android:title="@string/cutout_progress_download_enabled_title"
            android:defaultValue="true" />

        <com.alpha.settings.preferences.SystemSettingSwitchPreference
            android:key="cutout_progress_charging_ring_enabled"
            android:title="@string/cutout_progress_charging_ring_title"
            android:defaultValue="true" />

    </PreferenceCategory>

    <PreferenceCategory android:title="@string/cutout_progress_cat_appearance">

        <com.alpha.settings.preferences.SystemSettingListPreference
            android:key="cutout_progress_ring_color_mode"
            android:title="@string/cutout_progress_ring_color_mode_title"
            android:summary="%s"
            android:entries="@array/cutout_progress_ring_color_mode_entries"
            android:entryValues="@array/cutout_progress_ring_color_mode_values"
            android:defaultValue="0"
            android:dependency="cutout_progress_download_enabled" />

        <Preference
            android:key="cutout_progress_ring_color"
            android:title="@string/cutout_progress_ring_color_title"
            android:summary="#2196F3"
            android:persistent="false"
            android:dependency="cutout_progress_download_enabled" />

        <com.alpha.settings.preferences.SystemSettingSeekBarPreference
            android:key="cutout_progress_stroke_width_dp10"
            android:title="@string/cutout_progress_stroke_width_title"
            android:max="80"
            settings:min="5"
            settings:interval="5"
            settings:units=" (×0.1 dp)"
            android:defaultValue="20" />

        <com.alpha.settings.preferences.SystemSettingSeekBarPreference
            android:key="cutout_progress_ring_opacity"
            android:title="@string/cutout_progress_ring_opacity_title"
            android:max="100"
            settings:min="50"
            settings:interval="1"
            settings:units="%"
            android:defaultValue="90" />

        <com.alpha.settings.preferences.SystemSettingSwitchPreference
            android:key="cutout_progress_bg_ring_enabled"
            android:title="@string/cutout_progress_bg_ring_enabled_title"
            android:defaultValue="true" />

        <com.alpha.settings.preferences.SystemSettingSwitchPreference
            android:key="cutout_progress_charging_pulse_enabled"
            android:title="@string/cutout_progress_charging_pulse_title"
            android:summary="@string/cutout_progress_charging_pulse_summary"
            android:defaultValue="true"
            android:dependency="cutout_progress_charging_ring_enabled" />

    </PreferenceCategory>

    <PreferenceCategory android:title="@string/cutout_progress_cat_island">

        <com.alpha.settings.preferences.SystemSettingSwitchPreference
            android:key="cutout_progress_island_compact"
            android:title="@string/cutout_progress_island_compact_title"
            android:summary="@string/cutout_progress_island_compact_summary"
            android:defaultValue="true" />

        <ListPreference
            android:key="cutout_progress_island_position"
            android:title="@string/cutout_progress_island_position_title"
            android:summary="%s"
            android:defaultValue="0"
            android:dependency="cutout_progress_island_compact"/>

        <com.alpha.settings.preferences.SystemSettingSeekBarPreference
            android:key="cutout_progress_dialog_bg_opacity"
            android:title="@string/cutout_island_bg_opacity_title"
            android:max="100"
            settings:min="40"
            settings:interval="1"
            settings:units="%"
            android:defaultValue="70" />

        <com.alpha.settings.preferences.SystemSettingSeekBarPreference
            android:key="cutout_progress_island_timeout"
            android:title="@string/cutout_island_timeout_title"
            android:max="10"
            settings:min="1"
            settings:interval="1"
            settings:units="s"
            android:defaultValue="5" />

    </PreferenceCategory>

</PreferenceScreen>
