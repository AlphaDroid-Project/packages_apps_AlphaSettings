<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/slash_row_container"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:baselineAligned="false"
    android:paddingTop="4dp"
    android:paddingBottom="4dp"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:background="@android:color/transparent">

    <!-- FORCED HEIGHT 70dp -->
    <LinearLayout
        android:id="@+id/slash_content_area"
        android:layout_width="match_parent"
        android:layout_height="70dp"
        android:orientation="horizontal"
        android:background="@drawable/bg_alpha_slash_row">

        <!-- Text Container -->
        <LinearLayout
            android:id="@+id/slash_left_container"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginEnd="60dp"
            android:gravity="center_vertical"
            android:orientation="vertical"
            android:paddingStart="24dp"
            android:paddingEnd="4dp">

            <TextView
                android:id="@+id/slash_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:singleLine="true"
                android:textAppearance="?android:attr/textAppearanceListItem"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/slash_summary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="0dp"
                android:textAppearance="?android:attr/textAppearanceSmall"
                android:textColor="?android:attr/textColorSecondary"
                android:maxLines="1"
                android:ellipsize="end" />
        </LinearLayout>

        <!-- Icon Container -->
        <!-- The container is 72dp wide (16dp slant + 56dp solid) -->
        <FrameLayout
            android:id="@+id/slash_right_container"
            android:layout_width="72dp"
            android:layout_height="match_parent"
            android:layout_marginStart="-72dp">

            <!--
                 To center visually in the solid part:
                 The solid part starts 16dp from the left edge of this container.
                 So we add marginStart="16dp" to push it out of the slant area,
                 then gravity="center" handles the rest within the remaining space.

                 Alternatively, just gravity="center" centers it in the full 72dp.
                 Since the slant is on the left, centering in 72dp makes it look
                 slightly left of the solid mass center.

                 Let's use layout_marginStart="8dp" to nudge it right,
                 into the 'meaty' part of the slash.
            -->
            <ImageView
                android:id="@+id/slash_icon"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:layout_gravity="center"
                android:layout_marginStart="8dp" />
        </FrameLayout>

    </LinearLayout>
</LinearLayout>
