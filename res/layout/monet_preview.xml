<?xml version="1.0" encoding="utf-8"?>
<!--
    SPDX-FileCopyrightText: 2026 AlphaDroid
    SPDX-License-Identifier: Apache-2.0

    Inner mock uses @color/settingslib_materialColor* so palette swatches track Monet.
    Root background: activity theme (see MonetSettings); matches list/window under SubSettings.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="?android:attr/colorBackground"
    android:paddingHorizontal="12dp"
    android:paddingTop="8dp"
    android:paddingBottom="32dp"
    android:layout_marginBottom="12dp"
    android:gravity="center_horizontal">

    <FrameLayout
        android:layout_width="296dp"
        android:layout_height="236dp"
        android:background="@drawable/monet_preview_device_shell"
        android:backgroundTint="@color/settingslib_materialColorSurfaceContainer">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <!-- Status bar -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="32dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingHorizontal="16dp"
                android:background="@color/settingslib_materialColorSurfaceContainerHigh">

                <View
                    android:layout_width="72dp"
                    android:layout_height="9dp"
                    android:background="@drawable/monet_preview_rounded_chip"
                    android:backgroundTint="@color/settingslib_materialColorSurfaceContainerHighest"
                    android:alpha="0.9" />

                <View
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:layout_weight="1" />

                <View
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:background="@drawable/monet_preview_swatch_circle"
                    android:backgroundTint="@color/settingslib_materialColorSurfaceContainerHighest" />
            </LinearLayout>

            <!-- Content -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:background="@color/settingslib_materialColorSurface"
                android:padding="12dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical">

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="44dp"
                        android:background="@drawable/monet_preview_rounded_chip"
                        android:backgroundTint="@color/settingslib_materialColorPrimaryContainer" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="8dp" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="36dp"
                        android:background="@drawable/monet_preview_rounded_chip"
                        android:backgroundTint="@color/settingslib_materialColorSecondaryContainer" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="8dp" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="30dp"
                        android:background="@drawable/monet_preview_rounded_chip"
                        android:backgroundTint="@color/settingslib_materialColorTertiaryContainer" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_weight="1" />

                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">

                        <View
                            android:layout_width="44dp"
                            android:layout_height="44dp"
                            android:layout_gravity="end|bottom"
                            android:background="@drawable/monet_preview_swatch_circle"
                            android:backgroundTint="@color/settingslib_materialColorPrimary"
                            android:elevation="2dp" />
                    </FrameLayout>
                </LinearLayout>
            </FrameLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="5dp"
                android:background="@color/settingslib_materialColorSurfaceContainerHigh" />
        </LinearLayout>
    </FrameLayout>

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:paddingTop="12dp">

        <View
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_marginHorizontal="4dp"
            android:background="@drawable/monet_preview_swatch_circle"
            android:backgroundTint="@color/settingslib_materialColorPrimary"
            android:contentDescription="@string/monet_engine_preview_swatch_primary" />

        <View
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_marginHorizontal="4dp"
            android:background="@drawable/monet_preview_swatch_circle"
            android:backgroundTint="@color/settingslib_materialColorSecondary"
            android:contentDescription="@string/monet_engine_preview_swatch_secondary" />

        <View
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_marginHorizontal="4dp"
            android:background="@drawable/monet_preview_swatch_circle"
            android:backgroundTint="@color/settingslib_materialColorTertiary"
            android:contentDescription="@string/monet_engine_preview_swatch_tertiary" />

        <View
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_marginHorizontal="4dp"
            android:background="@drawable/monet_preview_swatch_circle"
            android:backgroundTint="@color/settingslib_materialColorSurfaceVariant"
            android:contentDescription="@string/monet_engine_preview_swatch_surface" />

        <View
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_marginHorizontal="4dp"
            android:background="@drawable/monet_preview_swatch_circle"
            android:backgroundTint="@color/settingslib_materialColorOutline"
            android:contentDescription="@string/monet_engine_preview_swatch_outline" />

        <View
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_marginHorizontal="4dp"
            android:background="@drawable/monet_preview_swatch_circle"
            android:backgroundTint="@color/settingslib_materialColorSurfaceInverse"
            android:contentDescription="@string/monet_engine_preview_swatch_inverse" />

        <View
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_marginHorizontal="4dp"
            android:background="@drawable/monet_preview_swatch_circle"
            android:backgroundTint="@color/settingslib_materialColorError"
            android:contentDescription="@string/monet_engine_preview_swatch_error" />
    </LinearLayout>
</LinearLayout>
