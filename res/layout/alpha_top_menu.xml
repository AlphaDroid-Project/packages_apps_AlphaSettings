<GridLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/alpha_top_menu"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layout_marginTop="?android:attr/listPreferredItemPaddingStart"
    android:paddingStart="?android:attr/listPreferredItemPaddingStart"
    android:paddingEnd="?android:attr/listPreferredItemPaddingEnd"
    android:gravity="center"
    android:columnCount="2"
    android:fadingEdge="horizontal|vertical"
    android:rowCount="5">

    <FrameLayout
        android:id="@+id/ui_layout"
        android:layout_width="0dp"
        android:layout_height="@dimen/alpha_settings_preference_height"
        android:layout_columnWeight="1"
        android:layout_margin="8dp"
        android:background="@drawable/ui"
        android:gravity="center"
        android:orientation="vertical">

        <ImageView
            android:id="@+id/ui_icon"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:scaleType="centerInside"
            android:src="@drawable/ic_ui"
            android:visibility="gone" />

        <TextView
            android:id="@+id/ui_text"
            style="@style/AlphaSettingsPreferenceTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/ui_title_short" />
    </FrameLayout>

    <FrameLayout
        android:id="@+id/statusbar_layout"
        android:layout_width="0dp"
        android:layout_height="@dimen/alpha_settings_preference_height"
        android:layout_columnWeight="1"
        android:layout_margin="8dp"
        android:background="@drawable/statusbar"
        android:gravity="center"
        android:measureAllChildren="true"
        android:orientation="vertical">

        <ImageView
            android:id="@+id/statusbar_icon"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:scaleType="centerInside"
            android:src="@drawable/ic_settings_statusbar"
            android:visibility="gone" />

        <TextView
            android:id="@+id/statusbar_text"
            style="@style/AlphaSettingsPreferenceTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/statusbar_title" />
    </FrameLayout>

    <FrameLayout
        android:id="@+id/quick_settings_layout"
        android:layout_width="0dp"
        android:layout_height="@dimen/alpha_settings_preference_height"
        android:layout_columnWeight="1"
        android:layout_margin="8dp"
        android:background="@drawable/qs"
        android:gravity="center"
        android:orientation="vertical">

        <ImageView
            android:id="@+id/quick_settings_icon"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:scaleType="centerInside"
            android:src="@drawable/ic_settings_quicksettings"
            android:visibility="gone" />

        <TextView
            android:id="@+id/quick_settings_text"
            style="@style/AlphaSettingsPreferenceTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/quicksettings_title_short" />
    </FrameLayout>

    <FrameLayout
        android:id="@+id/buttons_layout"
        android:layout_width="0dp"
        android:layout_height="@dimen/alpha_settings_preference_height"
        android:layout_columnWeight="1"
        android:layout_margin="8dp"
        android:background="@drawable/buttons"
        android:gravity="center"
        android:orientation="vertical">

        <ImageView
            android:id="@+id/buttons_icon"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:scaleType="centerInside"
            android:src="@drawable/ic_buttons"
            android:visibility="gone" />

        <TextView
            android:id="@+id/buttons_text"
            style="@style/AlphaSettingsPreferenceTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/button_title" />
    </FrameLayout>

    <FrameLayout
        android:id="@+id/lockscreen_layout"
        android:layout_width="0dp"
        android:layout_height="@dimen/alpha_settings_preference_height"
        android:layout_columnWeight="1"
        android:layout_margin="8dp"
        android:background="@drawable/lockscreen"
        android:gravity="center"
        android:orientation="vertical">

        <ImageView
            android:id="@+id/lockscreen_icon"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:scaleType="centerInside"
            android:src="@drawable/ic_settings_lockscreen"
            android:visibility="gone" />

        <TextView
            android:id="@+id/lockscreen_text"
            style="@style/AlphaSettingsPreferenceTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/lockscreen_title" />
    </FrameLayout>

    <FrameLayout
        android:id="@+id/notifications_layout"
        android:layout_width="0dp"
        android:layout_height="@dimen/alpha_settings_preference_height"
        android:layout_columnWeight="1"
        android:layout_margin="8dp"
        android:background="@drawable/notifications"
        android:gravity="center"
        android:orientation="vertical">

        <ImageView
            android:id="@+id/notifications_icon"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:scaleType="centerInside"
            android:src="@drawable/ic_notifications"
            android:visibility="gone" />

        <TextView
            android:id="@+id/notifications_text"
            style="@style/AlphaSettingsPreferenceTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:alpha="0.6"
            android:text="@string/notifications_title" />
    </FrameLayout>

    <FrameLayout
        android:id="@+id/sound_layout"
        android:layout_width="0dp"
        android:layout_height="@dimen/alpha_settings_preference_height"
        android:layout_columnWeight="1"
        android:layout_margin="8dp"
        android:background="@drawable/sound"
        android:gravity="center"
        android:orientation="vertical">

        <ImageView
            android:id="@+id/sound_icon"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:scaleType="centerInside"
            android:src="@drawable/ic_settings_sound"
            android:visibility="gone" />

        <TextView
            android:id="@+id/sound_text"
            style="@style/AlphaSettingsPreferenceTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/sound_title" />
    </FrameLayout>

    <FrameLayout
        android:id="@+id/misc_layout"
        android:layout_width="0dp"
        android:layout_height="@dimen/alpha_settings_preference_height"
        android:layout_columnWeight="1"
        android:layout_margin="8dp"
        android:background="@drawable/misc"
        android:gravity="center"
        android:orientation="vertical">

        <ImageView
            android:id="@+id/misc_icon"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:scaleType="centerInside"
            android:src="@drawable/ic_settings_misc"
            android:visibility="gone" />

        <TextView
            android:id="@+id/misc_text"
            style="@style/AlphaSettingsPreferenceTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/misc_title_short" />
    </FrameLayout>

    <FrameLayout
        android:id="@+id/about_layout"
        android:layout_width="0dp"
        android:layout_height="@dimen/alpha_settings_preference_height"
        android:layout_columnSpan="2"
        android:layout_columnWeight="1"
        android:layout_margin="8dp"
        android:background="@drawable/about_alpha"
        android:gravity="center"
        android:orientation="vertical">

        <ImageView
            android:id="@+id/about_icon"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:scaleType="centerInside"
            android:src="@drawable/ic_settings_alpha"
            android:visibility="gone" />

        <TextView
            android:id="@+id/about_text"
            style="@style/AlphaSettingsPreferenceTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/about_alpha" />
    </FrameLayout>
</GridLayout>
